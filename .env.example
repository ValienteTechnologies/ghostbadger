# Copy to .env and fill in values before running.
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-string

# Base URL of your Ghostwriter instance (no trailing slash)
GHOSTWRITER_URL=https://ghostwriter.example.com
# Set to false to disable SSL certificate verification (e.g. self-signed certs)
# GHOSTWRITER_VERIFY_SSL=true
# Cloudflare Access service token (required if Ghostwriter is behind CF Access)
# GHOSTWRITER_CF_CLIENT_ID=
# GHOSTWRITER_CF_CLIENT_SECRET=
# BCP 47 language tag passed to the Vue rendering bundle (default: en)
# RENDER_LANGUAGE=en
# Optional: path to Ghostwriter media volume for evidence image fallback (local Docker deployments)
# GHOSTWRITER_MEDIA_PATH=/ghostwriter_media

# Vaultwarden integration (optional — leave blank to disable)
# CLIENT_ID, CLIENT_SECRET, MASTER_PASSWORD are entered in the UI at connect time
VAULTWARDEN_URL=https://vault.example.com
VAULTWARDEN_ORG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAULTWARDEN_COLLECTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
